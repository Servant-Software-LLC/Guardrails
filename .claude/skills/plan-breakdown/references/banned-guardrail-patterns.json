{
  // Banned guardrail-script patterns (SSOT §4.6, issue #346, GR2037).
  //
  // A data-driven registry of KNOWN-BAD regex constructions that a generated guardrail
  // script must NOT contain. `guardrails validate` scans every four-folder SCRIPT guardrail's
  // comment-stripped body against each entry's `badPattern` and emits ONE GR2037 error per
  // match, citing the entry `id` + `reason` + `goodPatternHint`.
  //
  // This is the SINGLE authored source: it lives beside the catalogue (so the doctrine side can
  // cite it) AND is embedded into Guardrails.Core via an <EmbeddedResource> Link (so the
  // validator loads it with zero runtime path discovery). One file, no drift.
  //
  // Quality bar (meta-tested — a malformed entry cannot ship): every entry carries inline
  // `mustMatch` fixtures the `badPattern` MUST catch and `mustNotMatch` fixtures it must NOT
  // catch. The meta-test compiles every `badPattern` (proving it is a valid regex), asserts it
  // matches ALL its `mustMatch` fixtures, and asserts it matches NONE of its `mustNotMatch`.
  //
  // Honest scope: matching regex TEXT inside guardrail source is defense-in-depth against
  // *accidental regression of a known-bad spelling*, not a proof — a determined respelling can
  // evade a given `badPattern`. It COMPLEMENTS the #302 author-time smoke-test and the
  // adversarial `/guardrails-review` pass; it does not replace them. Seeded small + honestly
  // (#73 + #187a) — grow it by adding a JSON object with two fixtures, not harness C#.
  "version": 1,
  "patterns": [
    {
      "id": "#73",
      // The hollow-assertion AVOID construction from the catalogue's #73 section: a guardrail
      // that greps a test file for the mere PRESENCE of an assertion keyword on a quantity token
      // (`Assert.*(Moved|Written|Count|Entities)`) passes on `Assert.Equal(0, x.Count)` — a
      // zero-quantity result reports green. The distinctive banned token is the 4-way
      // quantity-token alternation used as a keyword-presence match. The trailing negative lookahead
      // does NOT fire when a positivity check follows the construct WITHIN THE SAME quoted regex on
      // the same line (a '>' comparison, 'NotEmpty', or 'True(...)') — that form (e.g.
      // 'Assert.*(...Count...).*>\s*0') IS sufficient, so it is not hollow.
      "badPattern": "Assert.*\\(Moved\\|Written\\|Count\\|Entities\\)(?![^'\"\\r\\n]*(>|NotEmpty|True))",
      "reason": "hollow assertion: an 'Assert.*(Moved|Written|Count|Entities)' keyword-presence match with no positivity check passes on 'Assert.Equal(0, x.Count)' — a zero-quantity result reports green (catalogue #73).",
      "goodPatternHint": "require a STRICTLY-POSITIVE value, not the presence of an assertion keyword: '(>\\s*0|>=\\s*1|NotEmpty\\s*\\(|True\\s*\\([^)]*Count\\s*>\\s*0)' (or read the runner's recorded moved-count and assert > 0).",
      "mustMatch": [
        "if ($src -match 'Assert.*\\([^)]*(Moved|Written|Count|Entities)') { exit 0 }",
        "if ! grep -Eq 'Assert.*\\([^)]*(Moved|Written|Count|Entities)' \"$test\"; then exit 1; fi"
      ],
      "mustNotMatch": [
        "if ($src -notmatch '(>\\s*0|>=\\s*1|NotEmpty\\s*\\(|True\\s*\\([^)]*Count\\s*>\\s*0)') { exit 1 }",
        "if ($src -notmatch 'Assert.*Count\\s*>\\s*0') { exit 1 }",
        "if ($src -notmatch 'Assert.*(Moved|Written|Count|Entities).*>\\s*0') { exit 1 }"
      ]
    },
    {
      "id": "#187a",
      // The unanchored ours/theirs conflict-marker construction (the exact #346 regression). A
      // '<<<<<<<'/'>>>>>>>' marker scan with NO line-start '^' anchor false-fires on a
      // whitespace-preceded marker (the '(^|[[:space:]])' incident form), a raw '<<<<<<<' /
      // grep -Eq '<<<<<<<', etc. GOOD form: line-anchored ours/theirs, '(?m)^<<<<<<<' / '(?m)^>>>>>>>'.
      // Rule: a 7-char '<' or '>' run NOT immediately preceded by '^'.
      //
      // NOTE — the bare '=======' middle marker is NOT banned here. #187 retires it from the DOCTRINE
      // (drop it from the good form), but a '={7}' ban was the design-of-record's explicitly-DEFERRED
      // "#187b" and adds no coverage of the actual #346 incident (which had no '======='); it would
      // false-fire on a legitimate markdown-setext-underline / banner check. The mustNotMatch fixtures
      // below PIN that '======='-based checks stay clean. Accepted residual limit: a rare INLINE
      // (trailing) comment on a non-comment line that literally spells 7+ '<'/'>' would still trip.
      "badPattern": "(?<!\\^)<{7}|(?<!\\^)>{7}",
      "reason": "unanchored conflict-marker check: a '<<<<<<<'/'>>>>>>>' scan with no line-start '^' anchor false-fires on a whitespace-preceded marker (the '(^|[[:space:]])' #346-incident form) — it matches the token anywhere on a line. (Accepted residual: a rare inline-comment mention of 7+ literal '<'/'>' on a non-comment line.)",
      "goodPatternHint": "anchor the ours/theirs tokens to line start: '(?m)^<<<<<<<' / '(?m)^>>>>>>>' (POSIX: grep -E '^<<<<<<<'). Both markers write at column 0, so the anchor is false-positive-free.",
      "mustMatch": [
        "grep -Eq '(^|[[:space:]])(<<<<<<<|>>>>>>>)' \"$rel\"",
        "if ($content -match '<<<<<<<' -or $content -match '>>>>>>>') { exit 1 }",
        "grep -Eq '<<<<<<<' \"$file\" && exit 1"
      ],
      "mustNotMatch": [
        "if ($content -match '(?m)^<<<<<<<' -or $content -match '(?m)^>>>>>>>') { exit 1 }",
        "if ($count -le 0) { Write-Output 'no output'; exit 1 }",
        "if ($doc -notmatch '(?m)^=======') { exit 1 }",
        "if ($report -notmatch '=======') { exit 1 }"
      ]
    },
    {
      "id": "#462",
      // A DEAD #179 re-emit: a `dotnet test` line carrying `-v q` in a script that then greps for the
      // failure-detail block. `-v q` SUPPRESSES that block — `Error Message:`, the assertion line,
      // `Expected:`, `Actual:`, `Stack Trace:` — leaving only `[FAIL] <name>`. The harness feeds back only
      // the TAIL of a failed guardrail's stdout, which is exactly why #179 requires the detail be re-emitted
      // at the END; under `-v q` the Select-String has nothing left to find, so the next attempt sees WHAT
      // failed and never WHY, and retries blind. The guardrail still fails correctly and still looks right
      // on the page — only the diagnostic value is gone, and nothing in the output announces it. Measured,
      // not inferred (#248): same project, same filter, the flag the only difference (stack file §4.3, row 3
      // of the verbosity table).
      //
      // WHY THE CONJUNCTION, and what is deliberately NOT banned. The pair is self-defeating from the script
      // text alone — no cross-file analysis, which is what makes it registry-shaped at all. A `-v q` on a
      // `dotnet test` with NO re-emit grep is deliberately left SILENT here. Doctrine forbids that too
      // (§4.3 point 3, so the two halves of a TDD pair stay copy-pasteable and nobody propagates the flag
      // onto a forward check by cloning a sibling file) — but it is not text-locally self-contradictory: on
      // an INVERSE `tests-fail-on-stubs` check a NON-zero exit is the success condition, so there is no
      // failure detail to preserve and the flag costs nothing. GR2037 is an ERROR that blocks `validate`, so
      // that half stays doctrine enforced by review, not by this lint.
      //
      // THE TRIGGER TOKENS ARE EXACTLY THE LINES `-v q` DELETES. `\[FAIL\]` is deliberately absent from the
      // alternation: it is the one line the flag PRESERVES, so a re-emit that greps only for it is not
      // defeated by the flag (it is a weak re-emit — a different, non-text-local finding). A PowerShell
      // backtick line-continuation is tolerated between `dotnet test` and the flag, because the §21 baseline
      // preflight is habitually written that way; a PLAIN newline is not, so a legitimate
      // `dotnet build … -v q` line sitting above a correct `dotnet test` + re-emit stays silent.
      //
      // Two accepted residuals, both named honestly. MISS: a `dotnet test` whose verbosity flag is
      // assembled into a variable instead of written on the command line. FALSE-FIRE: a script that runs
      // `dotnet test … -v q` and, for an unrelated reason, contains the bare words `Expected:` / `Actual:`
      // (e.g. in a Write-Output line). Both of the tokens that make that possible are kept because #462
      // names them; and a script in that shape is violating §4.3 point 3 regardless, so the fire is
      // directionally right even where the message is not the sharpest available.
      "badPattern": "dotnet\\s+test\\b(?:[^\\r\\n]|(?<=`)\\r?\\n)*[ \\t](?:-v|--verbosity)[\\s:=]+q[\\s\\S]{0,4000}?(?:Error Message|Stack Trace|Assert\\\\\\.|Expected:|Actual:)",
      "reason": "dead #179 re-emit: this guardrail passes '-v q' to 'dotnet test' AND then greps for the failure-detail block, but '-v q' SUPPRESSES that block (Error Message / Expected / Actual / Stack Trace), leaving only '[FAIL] <name>' — so the re-emit finds nothing, the retry-feedback tail shows WHAT failed but never WHY, and the next attempt retries blind. '-v q' is doctrine for 'dotnet build' ONLY (stack file dotnet.md §4.3).",
      "goodPatternHint": "drop '-v q' from the TEST command (keep '--nologo'; keep '-v q' on 'dotnet build'), and pin the culture with `$env:DOTNET_CLI_UI_LANGUAGE = 'en'` as the first line so the summary the zero-match guard reads is not localized — dotnet.md §4.2 (the re-emit) + §4.3 (the canonical forward form).",
      "mustMatch": [
        "$log = & dotnet test tests/Guardrails.Core.Tests/Guardrails.Core.Tests.csproj --filter \"Category=ModelTieringStage1\" --nologo -v q 2>&1\nif ($code -ne 0) {\n    $log | Select-String -Pattern '^\\s*(Failed|Error Message|Assert\\.|Expected|Actual)' | ForEach-Object { Write-Output $_.Line }\n    exit 1\n}",
        "$out = dotnet test tests/Inventory.Tests --filter $filter --no-build --nologo -v q 2>&1\n$detail = $out | Select-String -Pattern '\\[FAIL\\]|Error Message:|Assert\\.|Exception|Stack Trace:|Expected:|Actual:'",
        "$log = & dotnet test tests/Guardrails.Core.Tests/Guardrails.Core.Tests.csproj `\n    --filter \"Category!=ModelTieringStage1\" --nologo -v q 2>&1\n$log | Select-String -Pattern '^\\s*(Failed|Error Message|Assert\\.)'",
        "$out = dotnet test tests/Inventory.Tests --filter $filter --verbosity quiet 2>&1\n$out | Select-String -Pattern 'Error Message:|Stack Trace:' | ForEach-Object { Write-Output $_.Line }"
      ],
      "mustNotMatch": [
        "$env:DOTNET_CLI_UI_LANGUAGE = 'en'\n$out = dotnet test tests/Inventory.Tests --filter $filter --no-build --nologo 2>&1\n$detail = $out | Select-String -Pattern '\\[FAIL\\]|Error Message:|Assert\\.|Exception|Stack Trace:|Expected:|Actual:'",
        "dotnet build tests/Inventory.Tests --nologo -v q\n$out = dotnet test tests/Inventory.Tests --filter $filter --nologo 2>&1\n$detail = $out | Select-String -Pattern '\\[FAIL\\]|Error Message:|Assert\\.|Stack Trace:|Expected:|Actual:'",
        "dotnet test tests/Inventory.Tests --filter $filter --nologo -v q\nif ($LASTEXITCODE -eq 0) { Write-Output 'the tests PASS against the stubs - they are tautological'; exit 1 }",
        "$out = dotnet test tests/Inventory.Tests --filter $filter --nologo -v q 2>&1\n$out | Select-String -Pattern '\\[FAIL\\]' | ForEach-Object { Write-Output $_.Line }",
        "dotnet run --project src/Guardrails.Cli -v quiet -- validate $folder\n$out | Select-String -Pattern 'Error Message:|Stack Trace:'"
      ]
    },
    {
      "id": "#608a",
      // A fail-open ErrorActionPreference (design 38 §3.1, §0.1): 'Continue'/'SilentlyContinue' lets a
      // terminating error unwind the guardrail past its own exit while pwsh -File still exits 0, so the
      // harness reads a false PASS. Measured: 358 of 900 committed guardrails set this explicitly; the
      // golden examples/ and the SSOT's own worked examples all use 'Stop'.
      //
      // Scoped to the ONE variable, not the word: keys on '$ErrorActionPreference' (with an optional
      // global:/script: scope prefix) assigned exactly 'Continue' or 'SilentlyContinue', so an unrelated
      // preference set to the same value -- '$ProgressPreference = "SilentlyContinue"' is the routine
      // idiom for suppressing progress-bar noise -- does not false-fire, and neither does the bare word
      // 'Continue' appearing in an unrelated string.
      //
      // Deliberately does NOT also require '$PSNativeCommandUseErrorActionPreference = $false'. A
      // guardrail that invokes no native command does not need that second line, and requiring it
      // everywhere would fail a correct script on this lint -- the false-RED half of the exact family
      // this plan is closing (design 38 §4.1a).
      "badPattern": "\\$(?:global:|script:)?ErrorActionPreference\\s*=\\s*(['\"])(?:Continue|SilentlyContinue)\\1",
      "reason": "fail-open ErrorActionPreference: 'Continue'/'SilentlyContinue' lets a terminating error unwind the guardrail past its own exit while `pwsh -File` still exits 0, so the harness reads a false PASS -- measured at 358 of 900 committed guardrails (design 38 §3.1, §0.1).",
      "goodPatternHint": "set $ErrorActionPreference = 'Stop' so an engine error terminates rather than unwinding silently past the guardrail's own exit; if the guardrail also runs a native command (dotnet, git, ...) whose non-zero exit is data, not an error, pair it with $PSNativeCommandUseErrorActionPreference = $false (design 38 §4.1a) -- a guardrail that runs no native command does not need that second line.",
      "mustMatch": [
        "$ErrorActionPreference = 'Continue'",
        "$ErrorActionPreference=\"SilentlyContinue\"",
        "$global:ErrorActionPreference='Continue'"
      ],
      "mustNotMatch": [
        "$ErrorActionPreference = 'Stop'",
        "$ProgressPreference = 'SilentlyContinue'",
        "Write-Output 'Continue processing the next file'"
      ]
    },
    {
      "id": "#608b",
      // A guardrail that does not end on an explicit exit (design 38 §3.4): the harness-owned abort shim
      // (§3.2) diverges from '-File' ONLY when a failing native command is followed by no explicit exit
      // -- measured at ZERO of 900 committed guardrails -- and this entry is what keeps that shape at
      // zero rather than merely assumed. Keys on the LAST non-blank line of the (comment-stripped) body:
      // bad when it is a real statement that is neither an 'exit' nor a lone closing brace.
      //
      // Two shapes are deliberately exempt, both load-bearing:
      //  (1) a lone '}' as the last line -- the try/finally cleanup idiom, where a guardrail that must
      //      remove a temp resource states its verdict via 'exit' on every branch INSIDE the try, and the
      //      finally's own last line is just the closing brace. A lint keyed on "the last line IS exit"
      //      would false-fire on this doctrinal idiom.
      //  (2) a single physical line carrying an 'exit' anywhere on it (e.g. an 'if (...) { exit 1 }' with
      //      an implicit fall-through when the condition is false) -- deliberately NOT the shape this
      //      entry polices; it catches a script that reaches its LAST line and states no verdict there at
      //      all, not every branch that could fall through earlier.
      "badPattern": "(?m)^(?=[^\\r\\n]*\\S[^\\r\\n]*\\s*\\z)(?!\\s*\\}\\s*\\z)(?![^\\r\\n]*\\bexit\\b)[^\\r\\n]+",
      "reason": "a guardrail that falls off the end without an explicit verdict -- the divergence the harness-owned abort shim does not close (design 38 §3.4): every reachable path must still reach an exit, or the shim's zero-instance assumption ('900 of 900 committed guardrails end on exit') silently rots.",
      "goodPatternHint": "end every reachable path on an explicit exit -- a bare 'exit 0'/'exit N' as the guardrail's last statement, or (for a script that must clean up a temp resource) an exit on every branch INSIDE a try, with the cleanup itself in a finally whose own last line may be the closing brace (design 38 §3.4).",
      "mustMatch": [
        "$ErrorActionPreference = 'Stop'\n$content = Get-Content -Raw $file\nif ($content -match 'TODO') { Write-Output 'todo found'; exit 1 }\nWrite-Output 'done'",
        "$ErrorActionPreference = 'Stop'\nif (Test-Path $file) { exit 1 }\n$result = 'ok'"
      ],
      "mustNotMatch": [
        "$ErrorActionPreference = 'Stop'\nif (Test-Path $file) { exit 1 }\nexit 0",
        "$tmp = Join-Path $env:TEMP ([Guid]::NewGuid())\nNew-Item -ItemType Directory -Path $tmp | Out-Null\ntry {\n    if (Test-Path $file) { exit 1 }\n    exit 0\n} finally {\n    Remove-Item $tmp -Recurse -Force\n}",
        "if ($content -match '<<<<<<<') { exit 1 }"
      ]
    },
    {
      "id": "#561",
      // Wrong preprocessing order (design 38 §4.1, §0.3): a scan copy that blanks block comments BEFORE
      // it neutralizes string literals lets a literal that spells a comment delimiter (a glob pattern's
      // own '/*', the repo's routine case) get mis-parsed as a real comment before the literal-neutralize
      // pass ever runs -- 29 of 31 committed dual-pass scans get the order wrong. The correct order is
      // literal-neutralize FIRST, then comment-strip.
      //
      // Keys on the SHAPE, not on the two spellings ('blankKeepingNewlines'/'neutralizeBraces') that
      // appear NOWHERE in this doctrine (design 38 §0.4) -- a lint keyed on those names would catch only
      // a copy-paste. The two markers are the constructs themselves: a block-comment delimiter regex
      // (the literal '/*' opening sequence, whatever variable or helper name wraps it) and a
      // quoted-string-matching regex (a negated-quote character class, '[^"...', whatever escaping
      // flavour it uses). This entry fires when a '/*' delimiter marker is found with no quoted-string
      // marker anywhere before it in the source -- true both when the string-neutralize pass runs AFTER
      // the comment-strip (the order violation) and when it is missing outright, and false the moment a
      // quoted-string marker precedes every '/*' marker, regardless of the names in between.
      "badPattern": "(?<!\\[\\^\\x22[\\s\\S]*)/\\x5C\\*",
      "reason": "wrong preprocessing order: this scan copy blanks block comments BEFORE it neutralizes string literals, so a literal that spells a comment delimiter (a glob pattern's own '/*', the repo's routine case) has already been mis-parsed as a real comment before the literal-neutralize pass ever runs, blanking real script text along with it (design 38 §4.1, §0.3 -- 29 of 31 committed dual-pass scans get the order wrong).",
      "goodPatternHint": "neutralize string literals FIRST, then strip comments -- swap the two [regex]::Replace passes, changing nothing else (design 38 §4.1): a literal's own '/*' can then never be mistaken for a comment delimiter, because by the time the comment-strip pass runs the literal's contents are already replaced.",
      "mustMatch": [
        "$raw = Get-Content -Raw $file\n$scan = [regex]::Replace($raw, '/\\*[\\s\\S]*?\\*/', ' ')\n$scan = [regex]::Replace($scan, '(?m)//[^\\r\\n]*', ' ')\n$scan = [regex]::Replace($scan, '\"(\\\\.|[^\"\\\\])*\"', '\"\"')\nif ($scan -match 'BANNED_TOKEN') { Write-Output 'found'; exit 1 }\nexit 0",
        "$scanCopy = Get-Content -Raw -Path $target\n$scanCopy = [regex]::Replace($scanCopy, '/\\*[\\s\\S]*?\\*/', '')\n$scanCopy = [regex]::Replace($scanCopy, '\"[^\"]*\"', '\"\"')\nif ($scanCopy -match 'FORBIDDEN') { exit 1 }\nexit 0"
      ],
      "mustNotMatch": [
        "$raw = Get-Content -Raw $file\n$scan = [regex]::Replace($raw, '\"(\\\\.|[^\"\\\\])*\"', '\"\"')\n$scan = [regex]::Replace($scan, '/\\*[\\s\\S]*?\\*/', ' ')\n$scan = [regex]::Replace($scan, '(?m)//[^\\r\\n]*', ' ')\nif ($scan -match 'BANNED_TOKEN') { Write-Output 'found'; exit 1 }\nexit 0",
        "$raw = Get-Content -Raw $file\n$scan = [regex]::Replace($raw, '\"(\\\\.|[^\"\\\\])*\"', '\"\"')\nif ($scan -match 'TOKEN') { exit 1 }\nexit 0",
        "$scan = [regex]::Replace($raw, '(?m)//[^\\r\\n]*', ' ')\nif ($scan -match 'TOKEN') { exit 1 }\nexit 0"
      ]
    }
  ]
}
