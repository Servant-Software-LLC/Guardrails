<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build policy is centralised in the repo-root Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.51.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!--
    #530 - the synthesised-pair distinctness proof is shared, not duplicated. Both suites synthesise
    guardrail bodies for their fixtures, and a second copy of the assertion is a second place for the
    assertion to rot. Linked rather than lifted into a third project: one file, two assemblies.
  -->
  <ItemGroup>
    <Compile Include="..\Guardrails.Core.Tests\TestSupport\SynthesisedPairProof.cs"
             Link="TestSupport\SynthesisedPairProof.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Guardrails.Core\Guardrails.Core.csproj" />
    <ProjectReference Include="..\..\src\Guardrails.Cli\Guardrails.Cli.csproj" />
  </ItemGroup>

</Project>
